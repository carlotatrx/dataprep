library(ggplot2)
# ---- 0. Settings ------------------------------------------------------------
data_dir <- "/scratch2/ccorbella/code/SummerSchool2026/"   # <- set to the folder containing the CSV files
modelchains <- c("CLMCOM-CCLM4-CCCMA", "CLMCOM-CCLM4-HADGEM", "SMHI-RCA-HADGEM")
# ---- 1. Load QM-corrected data for both periods ------------------------------
# NB: sep = ";" and dec = "." explicitly, since these files use "." as the
# decimal mark (not comma) -- avoids locale-dependent misparsing.
ref  <- read.csv(file.path(data_dir, "pr_INT_QMoutput_1991-2020.csv"),
sep = ";", dec = ".", stringsAsFactors = FALSE)
gwl3 <- read.csv(file.path(data_dir, "pr_INT_QMoutput_GWL3.csv"),
sep = ";", dec = ".", stringsAsFactors = FALSE)
ref
names(ref)
gwl3
names(gwl3)
# The GWL3.0 file encodes its 30-year window with dummy years 0001-0030
# (the file is a 30-year slice centred on the year each model chain first
# reaches +3.0C global warming, not real calendar years). We only need
# day/month for a climatology, plus a within-period year index (1-30) to
# average over. Dates are dd-mm-yyyy, parsed manually to avoid any
# locale/format ambiguity.
parse_dmy <- function(df) {
parts <- strsplit(df$date, "-")
df$day   <- as.integer(vapply(parts, `[`, character(1), 1))
df$month <- as.integer(vapply(parts, `[`, character(1), 2))
df$year  <- as.integer(vapply(parts, `[`, character(1), 3))
df
}
ref  <- parse_dmy(ref)
gwl3 <- parse_dmy(gwl3)
ref
gwl3
head(gwl3)
season_of <- function(m) {
factor(c("DJF","DJF","MAM","MAM","MAM","JJA","JJA","JJA",
"SON","SON","SON","DJF")[m],
levels = c("DJF", "MAM", "JJA", "SON"))
}
ref$season  <- season_of(ref$month)
gwl3$season <- season_of(gwl3$month)
ref$period  <- "REF (1991-2020)"
gwl3$period <- "GWL3.0"
ref
haed(ref)
head(ref)
head(gwl3)
ref$period  <- "REF (1991-2020)"
gwl3$period <- "GWL3.0"
# ---- 2. Long format: one row per date x modelchain ---------------------------
to_long <- function(df) {
df %>%
pivot_longer(cols = all_of(modelchains),
names_to = "modelchain", values_to = "pr") %>%
select(period, modelchain, year, month, season, pr)
}
data_long <- bind_rows(to_long(ref), to_long(gwl3))
to_long
data_long
to_long(ref)
ref
to_long(gwl2)
to_long(gwl3)
# ---- 1. Load QM-corrected data for both periods ------------------------------
# NB: sep = ";" and dec = "." explicitly, since these files use "." as the
# decimal mark (not comma) -- avoids locale-dependent misparsing.
ref  <- read.csv(file.path(data_dir, "pr_INT_QMoutput_1991-2020.csv"),
sep = ";", dec = ".", stringsAsFactors = FALSE, check.names=FALSE)
gwl3 <- read.csv(file.path(data_dir, "pr_INT_QMoutput_GWL3.csv"),
sep = ";", dec = ".", stringsAsFactors = FALSE, check.names=FALSE)
# The GWL3.0 file encodes its 30-year window with dummy years 0001-0030
# (the file is a 30-year slice centred on the year each model chain first
# reaches +3.0C global warming, not real calendar years). We only need
# day/month for a climatology, plus a within-period year index (1-30) to
# average over. Dates are dd-mm-yyyy, parsed manually to avoid any
# locale/format ambiguity.
parse_dmy <- function(df) {
parts <- strsplit(df$date, "-")
df$day   <- as.integer(vapply(parts, `[`, character(1), 1))
df$month <- as.integer(vapply(parts, `[`, character(1), 2))
df$year  <- as.integer(vapply(parts, `[`, character(1), 3))
df
}
ref  <- parse_dmy(ref)
gwl3 <- parse_dmy(gwl3)
season_of <- function(m) {
factor(c("DJF","DJF","MAM","MAM","MAM","JJA","JJA","JJA",
"SON","SON","SON","DJF")[m],
levels = c("DJF", "MAM", "JJA", "SON"))
}
ref$season  <- season_of(ref$month)
gwl3$season <- season_of(gwl3$month)
ref$period  <- "REF (1991-2020)"
gwl3$period <- "GWL3.0"
# ---- 2. Long format: one row per date x modelchain ---------------------------
to_long <- function(df) {
df %>%
pivot_longer(cols = all_of(modelchains),
names_to = "modelchain", values_to = "pr") %>%
select(period, modelchain, year, month, season, pr)
}
data_long <- bind_rows(to_long(ref), to_long(gwl3))
data_long
# ---- 3. Annual and seasonal totals per (period, modelchain, year) -----------
# Change signals for precipitation are computed on ACCUMULATED totals
# (annual/seasonal sums) rather than daily means, since daily precipitation
# is dominated by zeros and short intense events and a daily-mean change
# signal would be a poor/unstable summary.
annual_totals <- data_long %>%
group_by(period, modelchain, year) %>%
summarise(pr_sum = sum(pr, na.rm = TRUE), .groups = "drop") %>%
mutate(season = "ANNUAL")
seasonal_totals <- data_long %>%
group_by(period, modelchain, year, season) %>%
summarise(pr_sum = sum(pr, na.rm = TRUE), .groups = "drop") %>%
mutate(season = as.character(season))
totals <- bind_rows(annual_totals, seasonal_totals) %>%
mutate(season = factor(season, levels = c("ANNUAL", "DJF", "MAM", "JJA", "SON")))
# 30-year mean total per period / modelchain / season
mean_totals <- totals %>%
group_by(period, modelchain, season) %>%
summarise(pr_mean = mean(pr_sum), .groups = "drop")
# ---- 4. Change signal: GWL3.0 minus REF --------------------------------------
change_signal <- mean_totals %>%
pivot_wider(names_from = period, values_from = pr_mean) %>%
rename(REF = `REF (1991-2020)`, GWL3 = `GWL3.0`) %>%
mutate(
change_abs = GWL3 - REF,                # mm
change_rel = 100 * (GWL3 - REF) / REF   # %
)
print(change_signal)
# ---- 5. Plot: mean annual & seasonal change signal (relative, %) ------------
p_change_rel <- ggplot(change_signal, aes(x = season, y = change_rel, fill = modelchain)) +
geom_col(position = position_dodge(width = 0.7), width = 0.6) +
geom_hline(yintercept = 0, linewidth = 0.3) +
labs(title = "Precipitation change signal: GWL3.0 minus Reference (1991-2020)",
subtitle = "QM-corrected model chains, station INT",
x = NULL, y = "Relative change (%)", fill = "Model chain") +
theme_minimal(base_size = 12) +
theme(legend.position = "bottom")
print(p_change_rel)
# Companion plot in absolute mm (sanity check, esp. for seasons with small REF)
p_change_abs <- ggplot(change_signal, aes(x = season, y = change_abs, fill = modelchain)) +
geom_col(position = position_dodge(width = 0.7), width = 0.6) +
geom_hline(yintercept = 0, linewidth = 0.3) +
labs(title = "Precipitation change signal (absolute): GWL3.0 minus Reference",
subtitle = "QM-corrected model chains, station INT",
x = NULL, y = "Absolute change (mm)", fill = "Model chain") +
theme_minimal(base_size = 12) +
theme(legend.position = "bottom")
print(p_change_abs)
# ---- 6. Absolute annual cycle: mean monthly totals, REF vs GWL3.0 -----------
monthly_totals <- data_long %>%
group_by(period, modelchain, year, month) %>%
summarise(pr_sum = sum(pr, na.rm = TRUE), .groups = "drop") %>%
group_by(period, modelchain, month) %>%
summarise(pr_mean = mean(pr_sum), .groups = "drop")
p_cycle <- ggplot(monthly_totals,
aes(x = month, y = pr_mean, colour = period, linetype = period)) +
geom_line(linewidth = 0.9) +
geom_point(size = 1.8) +
facet_wrap(~modelchain, ncol = 1) +
scale_x_continuous(breaks = 1:12, labels = month.abb) +
labs(title = "Absolute annual cycle of precipitation: Reference vs GWL3.0",
subtitle = "Mean monthly total precipitation, QM-corrected model chains",
x = NULL, y = "Mean monthly precipitation (mm)",
colour = "Period", linetype = "Period") +
theme_minimal(base_size = 12) +
theme(legend.position = "bottom")
print(p_cycle)
# ---- 7. Save plots (optional) ------------------------------------------------
# ---- 7. Save plots (optional) ------------------------------------------------
# ggsave("pr_change_signal_relative.png", p_change_rel, width = 8, height = 5, dpi = 300)
# ---- 7. Save plots (optional) ------------------------------------------------
# ggsave("pr_change_signal_relative.png", p_change_rel, width = 8, height = 5, dpi = 300)
# ggsave("pr_change_signal_absolute.png", p_change_abs, width = 8, height = 5, dpi = 300)
print(p_change_abs)
print(p_change_abs)
print(p_cycle)
print(p_change_rel)
# ---- 5. Plot: mean annual & seasonal change signal (relative, %) ------------
p_change_rel <- ggplot(change_signal, aes(x = season, y = change_rel, fill = modelchain)) +
geom_col(position = position_dodge(width = 0.7), width = 0.6) +
geom_hline(yintercept = 0, linewidth = 0.3) +
labs(title = "Precipitation change signal: GWL3.0 minus Reference (1991-2020) in Interlaken",
subtitle = "QM-corrected model chains",
x = NULL, y = "Relative change (%)", fill = "Model chain") +
theme_minimal(base_size = 12) +
theme(legend.position = "bottom")
print(p_change_rel)
# Companion plot in absolute mm (sanity check, esp. for seasons with small REF)
p_change_abs <- ggplot(change_signal, aes(x = season, y = change_abs, fill = modelchain)) +
geom_col(position = position_dodge(width = 0.7), width = 0.6) +
geom_hline(yintercept = 0, linewidth = 0.3) +
labs(title = "Precipitation change signal (absolute): GWL3.0 minus Reference in Interlaken",
subtitle = "QM-corrected model chains",
x = NULL, y = "Absolute change (mm)", fill = "Model chain") +
theme_minimal(base_size = 12) +
theme(legend.position = "bottom")
print(p_change_abs)
print(p_change_rel)
# Companion plot in absolute mm (sanity check, esp. for seasons with small REF)
p_change_abs <- ggplot(change_signal, aes(x = season, y = change_abs, fill = modelchain)) +
geom_col(position = position_dodge(width = 0.7), width = 0.6) +
geom_hline(yintercept = 0, linewidth = 0.3) +
labs(title = "Precipitation change signal (absolute): GWL3.0 minus Reference in Interlaken",
subtitle = "QM-corrected model chains",
x = NULL, y = "Absolute change (mm)", fill = "Model chain") +
theme_minimal(base_size = 12) +
theme(legend.position = "bottom")
print(p_change_abs)
# ---- 6. Absolute annual cycle: mean monthly totals, REF vs GWL3.0 -----------
monthly_totals <- data_long %>%
group_by(period, modelchain, year, month) %>%
summarise(pr_sum = sum(pr, na.rm = TRUE), .groups = "drop") %>%
group_by(period, modelchain, month) %>%
summarise(pr_mean = mean(pr_sum), .groups = "drop")
p_cycle <- ggplot(monthly_totals,
aes(x = month, y = pr_mean, colour = period, linetype = period)) +
geom_line(linewidth = 0.9) +
geom_point(size = 1.8) +
facet_wrap(~modelchain, ncol = 1) +
scale_x_continuous(breaks = 1:12, labels = month.abb) +
labs(title = "Absolute annual cycle of precipitation: Reference vs GWL3.0",
subtitle = "Mean monthly total precipitation, QM-corrected model chains",
x = NULL, y = "Mean monthly precipitation (mm)",
colour = "Period", linetype = "Period") +
theme_minimal(base_size = 12) +
theme(legend.position = "bottom")
print(p_cycle)
# ---- 7. Save plots (optional) ------------------------------------------------
ggsave("pr_change_signal_relative.png", p_change_rel, width = 8, height = 5, dpi = 300)
# ggsave("pr_change_signal_absolute.png", p_change_abs, width = 8, height = 5, dpi = 300)
ggsave("pr_annual_cycle.png", p_cycle, width = 7, height = 9, dpi = 300)
ggsave("pr_change_signal_absolute.png", p_change_abs, width = 8, height = 5, dpi = 300)
# ---- 7. Year-to-year variability of seasonal means: REF vs GWL3.0 -----------
# `seasonal_totals` already holds exactly what we need: one seasonal total per
# (period, modelchain, season, year) -- i.e. 30 independent yearly values per
# period. Plotting their full distribution (not just mean +/- sd) shows shape
# changes a single spread statistic would hide: skew, bimodality, a heavier
# dry tail, etc.
seasonal_only <- seasonal_totals %>%
mutate(season = factor(season, levels = c("DJF", "MAM", "JJA", "SON")))
p_var_density <- ggplot(seasonal_only, aes(x = pr_sum, fill = period, colour = period)) +
geom_density(alpha = 0.35, linewidth = 0.7) +
# rug shows the actual 30 yearly values behind each density curve
geom_rug(aes(colour = period), alpha = 0.6, length = unit(0.03, "npc")) +
facet_grid(season ~ modelchain, scales = "free") +
labs(title = "Year-to-year variability of seasonal precipitation totals",
subtitle = "Density of the 30 seasonal values per period (REF vs GWL3.0), QM-corrected",
x = "Seasonal total precipitation (mm)", y = "Density",
fill = "Period", colour = "Period") +
theme_minimal(base_size = 11) +
theme(legend.position = "bottom",
strip.text.y = element_text(angle = 0))
print(p_var_density)
# Companion numeric summary: sd, IQR and CV per period, for reference alongside
# the density plots (useful in a short write-up, not a substitute for them).
seasonal_variability <- seasonal_only %>%
group_by(period, modelchain, season) %>%
summarise(
mean_pr = mean(pr_sum),
sd_pr   = sd(pr_sum),
iqr_pr  = IQR(pr_sum),
cv_pr   = sd_pr / mean_pr,          # coefficient of variation (unitless)
.groups = "drop"
) %>%
pivot_wider(names_from = period, values_from = c(mean_pr, sd_pr, iqr_pr, cv_pr))
print(seasonal_variability)
# ---- 8. Save plots (optional) ------------------------------------------------
# ---- 8. Save plots (optional) ------------------------------------------------
ggsave("pr_change_signal_relative.png", p_change_rel, width = 8, height = 5, dpi = 300)
ggsave("pr_change_signal_absolute.png", p_change_abs, width = 8, height = 5, dpi = 300)
ggsave("pr_annual_cycle.png", p_cycle, width = 7, height = 9, dpi = 300)
ggsave("pr_seasonal_variability_density.png", p_var_density, width = 9, height = 8, dpi = 300)
# ---- 8. Save plots (optional) ------------------------------------------------
ggsave("/scratch2/ccorbella/code/SummerSchool2026/pr_change_signal_relative.png", p_change_rel, width = 8, height = 5, dpi = 300)
ggsave("/scratch2/ccorbella/code/SummerSchool2026/pr_change_signal_absolute.png", p_change_abs, width = 8, height = 5, dpi = 300)
ggsave("/scratch2/ccorbella/code/SummerSchool2026/pr_annual_cycle.png", p_cycle, width = 7, height = 9, dpi = 300)
ggsave("/scratch2/ccorbella/code/SummerSchool2026/pr_seasonal_variability_density.png", p_var_density, width = 9, height = 8, dpi = 300)
p_cycle <- ggplot(monthly_totals,
aes(x = factor(month, levels = 1:12, labels = month.abb),
y = pr_mean, fill = period)) +
geom_col(position = position_dodge(width = 0.75), width = 0.65) +
facet_wrap(~modelchain, ncol = 1) +
labs(title = "Absolute annual cycle of precipitation: Reference vs GWL3.0",
subtitle = "Mean monthly total precipitation, QM-corrected model chains",
x = NULL, y = "Mean monthly precipitation (mm)", fill = "Period") +
theme_minimal(base_size = 12) +
theme(legend.position = "bottom")
print(p_cycle)
ggsave("/scratch2/ccorbella/code/SummerSchool2026/pr_annual_cycle.png", p_cycle, width = 7, height = 9, dpi = 300)
# per (period, modelchain, season) mean, to draw as a vertical reference line
seasonal_means <- seasonal_only %>%
group_by(period, modelchain, season) %>%
summarise(mean_pr = mean(pr_sum), .groups = "drop")
p_var_density <- ggplot(seasonal_only, aes(x = pr_sum, fill = period, colour = period)) +
geom_density(alpha = 0.35, linewidth = 0.7) +
# rug shows the actual 30 yearly values behind each density curve
geom_rug(aes(colour = period), alpha = 0.6, length = unit(0.03, "npc")) +
geom_vline(data = seasonal_means,
aes(xintercept = mean_pr, colour = period),
linetype = "dashed", linewidth = 0.8, show.legend = FALSE) +
facet_grid(season ~ modelchain, scales = "free") +
labs(title = "Year-to-year variability of seasonal precipitation totals",
subtitle = "Density of the 30 seasonal values per period (REF vs GWL3.0), QM-corrected",
x = "Seasonal total precipitation (mm)", y = "Density",
fill = "Period", colour = "Period") +
theme_minimal(base_size = 11) +
theme(legend.position = "bottom",
strip.text.y = element_text(angle = 0))
print(p_var_density)
ggsave("/scratch2/ccorbella/code/SummerSchool2026/pr_seasonal_variability_density.png", p_var_density, width = 9, height = 8, dpi = 300)
